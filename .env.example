# ── Database ──────────────────────────────────────────────────────────────────
# Railway provides this automatically when you add a PostgreSQL plugin.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/renotrack360?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET: generate with → node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 32+ chars. Rotate if ever exposed.
NEXTAUTH_SECRET="REPLACE-WITH-32-CHAR-RANDOM-STRING"

# NEXTAUTH_URL: your deployed Railway URL (no trailing slash)
NEXTAUTH_URL="https://your-app.up.railway.app"

# ── Super admin bootstrap ──────────────────────────────────────────────────────
# First login with these credentials auto-creates the owner account.
# Use a strong password (20+ chars, symbols). Never reuse elsewhere.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="REPLACE-WITH-STRONG-PASSWORD"

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_BASE_URL="https://your-app.up.railway.app"
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# ── Email (optional — without this, emails fall back to mailto: links) ────────
# Resend: https://resend.com — for system/transactional emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Authorized redirect URI: https://your-app.up.railway.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Sentry error monitoring ───────────────────────────────────────────────────
# Create a Next.js project at sentry.io
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ── PostHog analytics ─────────────────────────────────────────────────────────
# Get your key at posthog.com → Project settings
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Stripe (SaaS subscription billing + invoice payment links) ────────────────
# Create products at dashboard.stripe.com → Products
STRIPE_SECRET_KEY=""
STRIPE_CURRENCY="usd"
STRIPE_WEBHOOK_SECRET=""
# Price IDs from Stripe Dashboard → Products (create one per interval)
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_COMMAND_MONTHLY=""
STRIPE_PRICE_COMMAND_ANNUAL=""
# Founding coupon: create in Stripe Dashboard → Coupons ($1,000 off Pro annual, max 100 redemptions)
STRIPE_COUPON_FOUNDING=""

# ── File uploads ──────────────────────────────────────────────────────────────
# Cloudinary (recommended for Railway — files survive redeploys)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME (from cloudinary.com dashboard)
CLOUDINARY_URL=""
# Local fallback (dev only, not persistent on Railway)
LOCAL_UPLOAD_DIR="./uploads"

# ── AI providers (optional — user configures per-org in Settings) ─────────────
# These are not required; contractors enter their own keys in Settings > AI.

# ── Tenant / demo mode ────────────────────────────────────────────────────────
# TENANT_MODE: DEMO (show demo creds on login) | SINGLE (default) | MULTI (future)
TENANT_MODE="DEMO"

# SHOW_DEMO_CREDENTIALS: show demo login box on the login page even in SINGLE mode
SHOW_DEMO_CREDENTIALS="true"

# Demo user credentials — created by the seed script, shown on login page
DEMO_USER_EMAIL="demo@renotrack360.com"
DEMO_USER_PASSWORD="LiveDemo2025"

# ── Super admin ────────────────────────────────────────────────────────────────
# Comma-separated emails that get the platform Admin dashboard (/admin route)
# Defaults to ADMIN_EMAIL if not set
SUPER_ADMIN_EMAILS="admin@yourdomain.com"

# ── Security notes ────────────────────────────────────────────────────────────
# 1. Never commit .env to git — it is in .gitignore
# 2. Rotate NEXTAUTH_SECRET and ADMIN_PASSWORD before going live
# 3. Set all variables in Railway dashboard under project > Variables
# 4. DATABASE_URL is auto-injected by Railway PostgreSQL plugin — do not hardcode
