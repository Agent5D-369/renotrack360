generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PROJECT_MANAGER
  ESTIMATOR
  FIELD_CREW
  CLIENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum PlanTier {
  SOLO
  TEAM
  PRO
  ENTERPRISE
}

enum ProfileType {
  AGENT
  ARCHITECT
  DESIGNER
  HOMEOWNER
  COMMERCIAL_BUSINESS_OWNER
  COMMERCIAL_TENANT
  DEVELOPER
  INVESTOR
  CURRENT_CLIENT
  PAST_CLIENT
  PROPERTY_MANAGER
  GENERAL_CONTRACTOR
  VENDOR_SUBCONTRACTOR
  INSURANCE_ADJUSTER
  LENDER
  ATTORNEY
  MUNICIPAL_CONTACT
  OTHER
}

enum ProfileKind {
  PERSON
  ORGANIZATION
}

enum ClientStatus {
  NOT_CLIENT
  PROSPECT
  ACTIVE_CLIENT
  PAST_CLIENT
  VIP_CLIENT
  DO_NOT_WORK_WITH
}

enum LeadStage {
  NEW_LEAD
  RESEARCHING
  CONTACTED
  DISCOVERY_SCHEDULED
  WALKTHROUGH_SCHEDULED
  SCOPE_REQUESTED
  QUOTE_IN_PROGRESS
  QUOTE_SENT
  FOLLOW_UP_NEEDED
  WON
  LOST
  NURTURE
}

enum PropertyType {
  CONDO
  DUPLEX
  FOURPLEX
  LUXURY_HOME
  MULTIFAMILY
  RENTAL
  SINGLE_FAMILY_HOME
  STALE_LISTING
  VALUE_ADD_INVESTOR_PROPERTY
