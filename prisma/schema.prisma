enum QuoteStatus {
  INTAKE_NEEDED
  SITE_VISIT_NEEDED
  SCOPE_DRAFT
  PRICING
  REVIEW
  SENT
  APPROVED
  DECLINED
  CONVERTED_TO_JOB
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN_CONDITION
}

enum JobStatus {
  PRE_CONSTRUCTION
  DEPOSIT_RECEIVED
  MATERIALS_PLANNING
  DEMO
  ROUGH_IN
  INSPECTIONS
  DRYWALL_SURFACES
  FINISHES
  PUNCH_LIST
  FINAL_WALKTHROUGH
  COMPLETE
  WARRANTY_FOLLOW_UP
