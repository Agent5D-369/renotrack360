enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ChangeOrderStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  COMPLETED
  VOID
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum EstimateFollowUpStatus {
  SCHEDULED
  DUE
  COMPLETED
  SKIPPED
}

enum EstimateFollowUpType {
  CONFIRM_RECEIVED
  ANSWER_QUESTIONS
  DECISION_TIMELINE
  FINAL_CHECK_IN
  NURTURE
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum BudgetLineType {
  LABOR
  MATERIAL
  SUBCONTRACTOR
  EQUIPMENT
  PERMIT
  REIMBURSEMENT
  OVERHEAD
  CONTINGENCY
}

enum ResourceStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  RETIRED
}

enum PermitStatus {
  NOT_REQUIRED
  NEEDS_REVIEW
  DRAFTING
  SUBMITTED
  APPROVED
  INSPECTION_SCHEDULED
  PASSED
  FAILED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FeedbackStatus {
  REQUESTED
  RECEIVED
  REVIEW_REQUESTED
  PUBLISHED
  ARCHIVED
}

enum AiTaskStatus {
  QUEUED
  IN_PROGRESS
  NEEDS_REVIEW
  COMPLETED
  FAILED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  AZURE_OPENAI
  OPENROUTER
  XAI
  MISTRAL
  LOCAL_CUSTOM
  DEEPSEEK
  OPENAI_COMPATIBLE
}

enum ChecklistEntityType {
  LEAD
  PROPERTY
  QUOTE
  ESTIMATE
  JOB
  PHASE
  TASK
  CHANGE_ORDER
  INVOICE
  PERMIT
  SAFETY_AUDIT
  FIELD_REPORT
  CLOSEOUT
}

enum ChecklistItemAction {
  NONE
  CREATE_TASK
  REQUIRE_PHOTO
  REQUIRE_SIGNATURE
  CREATE_CHANGE_ORDER
  BLOCK_PHASE
  BLOCK_INVOICE
  CLIENT_DECISION
}

enum EvidenceType {
  PHOTO
  DOCUMENT
  SIGNATURE
  NOTE
  VIDEO
}

enum ApprovalStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
  CHANGES_REQUESTED
  EXPIRED
}

enum ImportStatus {
  UPLOADED
  MAPPING
  VALIDATING
  READY
  IMPORTED
  FAILED
}

enum SelectionSheetStatus {
  DRAFT
  SENT
  CLIENT_REVIEWING
  APPROVED
  NEEDS_REVISION
  ORDERED
  INSTALLED
}

enum SelectionDecisionStatus {
  NOT_STARTED
  OPTIONS_SENT
  CLIENT_REVIEWING
  APPROVED
  NEEDS_REVISION
  ORDERED
  RECEIVED
  INSTALLED
  BACKORDERED
}

enum GoodBetterBestTier {
  GOOD
  BETTER
  BEST
  CUSTOM
}

enum ServiceStepAudience {
  ESTIMATOR
  FIELD_CREW
  CLIENT
  INTERNAL
}

enum QuoteSectionType {
  INCLUDED_SCOPE
  EXCLUSIONS
  ASSUMPTIONS
  ALLOWANCES
  RISK_NOTES
  PERMIT_NOTES
  CLIENT_NOTES
}

enum AgreementStatus {
  DRAFT
  COUNSEL_REVIEW
  APPROVED_TEMPLATE
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  VOID
}

enum TranslationStatus {
  DRAFT
  MACHINE_TRANSLATED
  HUMAN_REVIEW_NEEDED
  APPROVED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  STRIPE
  ACH
  CHECK
  CASH
  ZELLE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum FinancingStatus {
  NOT_NEEDED
  DISCUSSED
  CLIENT_INTERESTED
  APPLICATION_SENT
  PENDING
  APPROVED
  DECLINED
  SELF_FUNDED
}

enum ActivityType {
  CALL
  EMAIL
  TEXT
  MEETING
  SITE_VISIT
  FOLLOW_UP
  NOTE
  TASK
  QUOTE_SENT
  INVOICE_SENT
  PAYMENT_RECEIVED
}

enum FileEntityType {
  PROFILE
  PROPERTY
  QUOTE
  JOB
  WEEKLY_REPORT
  CHANGE_ORDER
  INVOICE
}

enum W9Status {
  NOT_REQUIRED
  NEEDED
  REQUESTED
  RECEIVED
  EXPIRED
  BLOCKED
}

enum VendorOnboardingStatus {
  NOT_STARTED
  INVITED
  DOCS_PENDING
  READY
  BLOCKED
  INACTIVE
}

model WaitlistEntry {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  company       String?
  planInterest  String?
  referralCode  String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  ipHash        String?
  calcLeakTotal Float?
  calcData      Json?
  convertedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Organization {
  costSourceVersions CostSourceVersion[]
  scopeItems ScopeItem[]

  id                 String   @id @default(cuid())
  name               String   @default("RenoTrack360")
  address            String?
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  brandColor         String?
  brandSecondaryColor String?
  companyTagline     String?
  reviewLink         String?
  defaultMarkup      Decimal  @default(18) @db.Decimal(10, 2)
  defaultContingency Decimal  @default(8) @db.Decimal(10, 2)
  defaultTargetMarginPercent Decimal @default(40) @db.Decimal(6, 2)
  ownerExceptionMarginPercent Decimal @default(35) @db.Decimal(6, 2)
  changeOrderApprovalThresholdCents Int?
  invoiceApprovalThresholdCents Int?
  notificationCadence String @default("WEEKLY")
  defaultPaymentSchedule Json?
  paymentTerms       String   @default("Payment is due by the invoice due date. Work changes require written approval.")
  estimateTerms      String   @default("Estimate is valid until the expiration date and subject to approved scope, site conditions, selections, and trade pricing.")
  invoiceTerms       String   @default("Invoices are payable by the listed due date. Card or ACH processing may be handled by Stripe when configured.")
  weeklyReportFooter String   @default("Prepared in RenoTech360 Command Center. Renovation operations from lead to closeout.")
  country            String   @default("US")
  themePreference    String   @default("flipside-field-light")
  stripeCustomerId   String?
  planTier           PlanTier @default(SOLO)
  subscriptionStatus SubscriptionStatus?
  subscriptionEndsAt DateTime?
  users              User[]
  memberships        Membership[]
  subscription        Subscription?
  profiles           Profile[]
  properties         Property[]
  leads              Lead[]
  quotes             Quote[]
  costCatalogItems   CostCatalogItem[]
  priceSnapshots     PriceSnapshot[]
  workItemVersions   WorkItemVersion[]
  costObservations   CostObservation[]
  paymentRevisions   PaymentRevision[]
  jobFinancialBaselines JobFinancialBaseline[]
  milestoneInvoiceDrafts MilestoneInvoiceDraft[]
  changeOrderSnapshots ChangeOrderSnapshot[]
  appliedChangeOrders AppliedChangeOrder[]
  costAssemblies     CostAssembly[]
  marketCostFactors  MarketCostFactor[]
  laborRates         LaborRate[]
  materialAllowances MaterialAllowance[]
  vendorQuotes       VendorQuote[]
  actualCosts        ActualCost[]
  teamCircles        TeamCircle[]
  projectTemplates   ProjectTemplate[]
  materialItems      MaterialItem[]
  equipmentAssets    EquipmentAsset[]
  toolAssets         ToolAsset[]
  aiAgents           AiAgent[]
  aiTasks            AiTask[]
  aiProviderConfigs  AiProviderConfig[]
  aiUsageLogs        AiUsageLog[]
  checklistTemplates ChecklistTemplate[]
  importJobs         ImportJob[]
  serviceTemplates   ServiceTemplate[]
  agreementTemplates AgreementTemplate[]
  agreements         Agreement[]
  translations       TranslationRecord[]
  serviceTags        ServiceTag[]
  profileRelationships ProfileRelationship[]
  dropdownOptions    DropdownOption[]
  voiceNotes         VoiceNote[]
  jobs               Job[]
  inviteTokens       InviteToken[]
  fileAssets         FileAsset[]
  auditEvents        AuditEvent[]
  smtpFromName    String?
  smtpFromEmail   String?
  smtpPassword    String?   // Gmail App Password (16-char code, not the real password)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(OWNER)
  uiMode        String    @default("POWER")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  memberships    Membership[]
  assignedLeads   Lead[]       @relation("LeadOwner")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role             @default(ADMIN)
  status         MembershipStatus @default(ACTIVE)
  invitedEmail   String?
  invitedAt      DateTime?
  acceptedAt     DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId        String             @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  planTier             PlanTier           @default(SOLO)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  activeJobLimit       Int                @default(3)
  monthlyEstimateLimit Int                @default(25)
  userLimit            Int                @default(2)
  notes                String?            @db.Text
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model InviteToken {
  id             String    @id @default(cuid())
  email          String
  organizationId String
  role           Role      @default(ADMIN)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedByUserId String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
}

model Profile {
  id                        String      @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileName               String
  profileKind               ProfileKind @default(PERSON)
  profileType               ProfileType
  clientStatus              ClientStatus @default(PROSPECT)
  companyName               String?
  companyProfileId          String?
  phone                     String?
  email                     String?
  website                   String?
  location                  String?
  source                    String?
  relationshipStrength      Int         @default(50)
  trustLevel                Int         @default(50)
  leadPotential             Int         @default(50)
  referralPotential         Int         @default(50)
  notes                     String?     @db.Text
  nextFollowUp              DateTime?
  w9Status                  W9Status    @default(NOT_REQUIRED)
  w9RequestedAt             DateTime?
  w9ReceivedAt              DateTime?
  w9FileAssetId             String?
  vendorOnboardingStatus    VendorOnboardingStatus @default(NOT_STARTED)
  insuranceExpiration       DateTime?
  complianceNotes           String?     @db.Text
  dedupeKey                 String?     @unique
  companyProfile            Profile?    @relation("ProfileCompany", fields: [companyProfileId], references: [id])
  companyContacts           Profile[]   @relation("ProfileCompany")
  relationshipsFrom         ProfileRelationship[] @relation("ProfileRelationshipFrom")
  relationshipsTo           ProfileRelationship[] @relation("ProfileRelationshipTo")
  serviceTags               ProfileServiceTag[]
  leads                     Lead[]      @relation("LeadProfile")
  agentProperties           Property[]  @relation("AgentProperties")
  investorProperties        Property[]  @relation("InvestorProperties")
  quotes                    Quote[]
  jobs                      Job[]
  assignedTasks             Task[]
  changeOrders              ChangeOrder[]
  estimates                 Estimate[]
  invoices                  Invoice[]
  payments                  Payment[]
  financingRecords          Financing[]
  activities                Activity[]
  teamMemberships           TeamCircleMember[]
  timeEntries               TimeEntry[]
  reimbursements            Reimbursement[]
  feedbackRequests          FeedbackRequest[]
  fieldAssignments          FieldAssignment[]
  selectionSheets           SelectionSheet[]
  agreements                Agreement[]
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  @@index([organizationId, profileName])
  @@index([organizationId, email])
  @@index([companyProfileId])
}

model ProfileRelationship {
  id             String       @id @default(cuid())
  organizationId String
  fromProfileId  String
  toProfileId    String
  relationshipType String
  notes          String?      @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromProfile    Profile      @relation("ProfileRelationshipFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile      Profile      @relation("ProfileRelationshipTo", fields: [toProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fromProfileId, toProfileId, relationshipType])
  @@index([organizationId])
}

model ServiceTag {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  category       String       @default("Trade")
  description    String?      @db.Text
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profiles       ProfileServiceTag[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

model ProfileServiceTag {
  profileId    String
  serviceTagId String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  serviceTag   ServiceTag @relation(fields: [serviceTagId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([profileId, serviceTagId])
}

model DropdownOption {
  id             String       @id @default(cuid())
  organizationId String
  optionSet      String
  label          String
  value          String
  description    String?      @db.Text
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  system         Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, optionSet, value])
  @@index([organizationId, optionSet])
}

model Property {
  id                 String      @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyAddress    String
  city               String
  state              String
  zip                String
  country            String   @default("US")
  propertyType       PropertyType
  occupancyStatus    String?
  ownerType          String?
  listingStatus      String?
  agentProfileId     String?
  investorProfileId  String?
  estimatedARV       Decimal?    @db.Decimal(12, 2)
  currentCondition   String?
  renovationGoal     String?
  riskNotes          String?     @db.Text
  photos             String[]    @default([])
  agentProfile       Profile?    @relation("AgentProperties", fields: [agentProfileId], references: [id])
  investorProfile    Profile?    @relation("InvestorProperties", fields: [investorProfileId], references: [id])
  leads              Lead[]
  quotes             Quote[]
  jobs               Job[]
  estimates          Estimate[]
  activities         Activity[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Lead {
  id                String      @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadName          String
  leadType          String?
  source            String?
  ownerUserId       String?
  relatedProfileId  String?
  relatedPropertyId String?
  estimatedBudget   Decimal?    @db.Decimal(12, 2)
  urgency           Int         @default(50)
  jobFitScore       Int         @default(50)
  trustFitScore     Int         @default(50)
  scopeClarity      Int         @default(50)
  financingNeed     Boolean     @default(false)
  probability       Int         @default(50)
  nextAction        String?
  followUpDate      DateTime?
  status            LeadStage   @default(NEW_LEAD)
  notes             String?     @db.Text
  archivedAt        DateTime?
  deletedAt         DateTime?
  owner             User?       @relation("LeadOwner", fields: [ownerUserId], references: [id])
  profile           Profile?    @relation("LeadProfile", fields: [relatedProfileId], references: [id])
  property          Property?   @relation(fields: [relatedPropertyId], references: [id])
  quotes            Quote[]
  activities        Activity[]
  estimateFollowUps EstimateFollowUp[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([ownerUserId])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Quote {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteName         String
  clientProfileId   String?
  propertyId        String?
  leadId            String?
  quoteStatus       QuoteStatus  @default(INTAKE_NEEDED)
  requestedDate     DateTime     @default(now())
  targetSendDate    DateTime?
  projectType       String?
  budgetRange       String?
  siteVisitRequired Boolean      @default(true)
  paidSiteVisit     Boolean      @default(false)
  consultationFee   Decimal?     @db.Decimal(12, 2)
  permitLikely      Boolean      @default(false)
  tradesNeeded      String[]     @default([])
  riskLevel         RiskLevel    @default(MEDIUM)
  totalLow          Decimal      @default(0) @db.Decimal(12, 2)
  totalTarget       Decimal      @default(0) @db.Decimal(12, 2)
  totalHigh         Decimal      @default(0) @db.Decimal(12, 2)
  gcMarkup          Decimal      @default(18) @db.Decimal(10, 2)
  contingency       Decimal      @default(8) @db.Decimal(10, 2)
  finalQuoteAmount  Decimal?     @db.Decimal(12, 2)
  notes             String?      @db.Text
  clientProfile     Profile?     @relation(fields: [clientProfileId], references: [id])
  property          Property?    @relation(fields: [propertyId], references: [id])
  lead              Lead?        @relation(fields: [leadId], references: [id])
  lineItems         QuoteLineItem[]
  estimates         Estimate[]
  jobs              Job[]
  financingRecords  Financing[]
  activities        Activity[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model QuoteLineItem {
  id                      String      @id @default(cuid())
  quoteId                 String
  scopeArea               String
  costCatalogItemId       String?
  lineItemName            String
  unitType                String
  quantity                Decimal     @default(1) @db.Decimal(12, 2)
  laborLow                Decimal     @default(0) @db.Decimal(12, 2)
  laborTarget             Decimal     @default(0) @db.Decimal(12, 2)
  laborHigh               Decimal     @default(0) @db.Decimal(12, 2)
  materialLow             Decimal     @default(0) @db.Decimal(12, 2)
  materialTarget          Decimal     @default(0) @db.Decimal(12, 2)
  materialHigh            Decimal     @default(0) @db.Decimal(12, 2)
  subcontractorCost       Decimal     @default(0) @db.Decimal(12, 2)
  markupPercent           Decimal     @default(18) @db.Decimal(10, 2)
  riskFactor              RiskLevel   @default(MEDIUM)
  totalLow                Decimal     @default(0) @db.Decimal(12, 2)
  totalTarget             Decimal     @default(0) @db.Decimal(12, 2)
  totalHigh               Decimal     @default(0) @db.Decimal(12, 2)
  manualTotalLow          Decimal?    @db.Decimal(12, 2)
  manualTotalTarget       Decimal?    @db.Decimal(12, 2)
  manualTotalHigh         Decimal?    @db.Decimal(12, 2)
  clientFacingDescription String?     @db.Text
  internalNotes           String?     @db.Text
  sortOrder               Int         @default(0)
  quote                   Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  costCatalogItem         CostCatalogItem? @relation(fields: [costCatalogItemId], references: [id])
  vendorQuotes            VendorQuote[]
  actualCosts             ActualCost[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model CostCatalogItem {
  id                    String    @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category              String
  serviceName           String
  unitType              String
  typicalQuantityRange  String?
  flipsideLowCost       Decimal   @db.Decimal(12, 2)
  flipsideTargetCost    Decimal   @db.Decimal(12, 2)
  flipsideHighCost      Decimal   @db.Decimal(12, 2)
  laborAssumptions      String?   @db.Text
  materialAssumptions   String?   @db.Text
  laborRange            String?
  materialRange         String?
